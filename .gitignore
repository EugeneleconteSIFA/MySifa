# Python
venv/
__pycache__/
*.py[cod]
.Python
*.egg-info/
.eggs/

# OS
.DS_Store
Thumbs.db

# Base locale (ne jamais versionner la DB active).
# CRITIQUE : ne JAMAIS tracker un .db dans git.
# Un blob git écrase la DB à chaque git reset --hard.
# En juillet 2026, app/data/production-v1.db et data/production.db étaient
# tous les deux trackés avec un blob vide (0 octet) — chaque pull cron du
# VPS écrasait la DB v1 en 8 Ko. Diagnostic 502 en boucle jusqu'au untrack.
data/production.db
data/production.db.*
data/*.bak
data/*.backup
app/data/*.db
app/data/*.db-*
*.db-journal
*.db-shm
*.db-wal
mysifa.db
production.db

# Widget Electron (build local — upload via deploy.sh --widget)
myprod-widget/node_modules/
myprod-widget/dist/

# Env / secrets
.env
.env.*
!.env.example
__pycache__/
*.pyc

# Dossiers temporaires cree par Claude (bypass cache MCP)
_to_delete/
_tmp_fresh*/

# Artefacts FUSE (montage bridge desktop)
.fuse_hidden*

# Relevés et exports de l'ERP RVGI — données réelles (clients, adresses, prix).
# Le rapport et le schéma se régénèrent avec scripts/inventaire_rvgi.ps1,
# les CSV avec scripts/export_rvgi_csv.ps1. Rien de tout ça n'a sa place
# dans le dépôt ; seul docs/rvgi/data_rvgi.md (sans donnée réelle) est versionné.
docs/rvgi/rapport_rvgi.md
docs/rvgi/schema_rvgi.json
data/rvgi_export/
erp_mirror.db
data/erp_mirror.db
data/logs/
data/rvgi_export.zip

# --- Decoupage du 27 aout 2026 ---
# Cache des hooks Claude (instantanes avant/apres edition).
.claude/.cache/
# Reglages Claude propres a un poste (les hooks partages sont dans settings.json).
.claude/settings.local.json
# Copies mortes en attente de suppression manuelle (device_bash ne peut pas rm).
_to_delete/
_tmp_fresh*/
