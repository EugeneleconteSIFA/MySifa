# Copier vers .env et renseigner les valeurs (ne jamais committer .env)

# Pont Access → MySifa (scripts/access_sync_*.py, lancés depuis le poste Windows)
# Générer la clé dans /settings > Clés API, puis, sur le poste :
#   setx MYSIFA_API_KEY "msk_..."   (rouvrir le terminal ensuite)
MYSIFA_API_KEY=

# Base de données (local par défaut : data/production.db)
# DB_PATH=/chemin/vers/production.db

# Email — Microsoft Graph (recommandé en prod M365)
SUPPORT_EMAIL_PROVIDER=graph
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_UPN=expeditions@sifa.pro

# MyExpé — devis transporteurs
# Boîte qui EXPÉDIE les demandes de tarif. Le créateur passe en copie : une
# demande d'appel d'offre engage le service, pas la personne qui a cliqué.
# Prérequis M365 : l'application Graph doit avoir le droit d'envoyer depuis
# cette boîte (permission Mail.Send, et ApplicationAccessPolicy si le tenant
# en applique une). Sinon l'envoi part en échec, visible dans le détail.
EXPE_DEVIS_FROM=expeditions@sifa.pro
# Copie systématique EN PLUS du créateur (vide = personne).
EXPE_DEVIS_CC=
# IP publiques d'où une ouverture d'email ne peut être que la nôtre.
# Virgules ; IP exacte ou préfixe terminé par un point.
EXPE_IPS_INTERNES=

# Email — SMTP (fallback si Graph indisponible)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=motdepasse
SMTP_FROM=noreply@mysifa.fr
SMTP_FROM_NAME=MySifa
# Liens portail transporteur / emails (prod : https://www.mysifa.com)
BASE_URL=https://www.mysifa.com
# Optionnel : surcharge explicite (sinon BASE_URL, sinon https://www.mysifa.com)
# PUBLIC_BASE_URL=https://www.mysifa.com

# MyTraduction — DeepL (portail AO fournisseur, BAT étiquette en anglais).
# Sans clé, les champs libres retombent sur le glossaire interne du BAT
# (app/services/bat_etiquette.py) — pas d'erreur, mais qualité moindre.
# La clé Free se termine par :fx et bascule l'URL sur api-free.deepl.com.
DEEPL_API_KEY=

# Chat — GIFs (clé gratuite sur developers.giphy.com)
GIPHY_API_KEY=votre_clé_ici

# Racine des pièces jointes chat/avatars/traca (servies via /uploads/*).
# Sur v1 (staging), pointer sur le dossier de v2 pour partager les fichiers,
# comme la DB. Sinon les pièces jointes envoyées depuis l'autre instance
# retournent 404. Défaut : <BASE_DIR>/uploads.
# UPLOADS_ROOT=/home/sifa/production-saas/uploads

# MyStock — unité de vente par défaut d'une référence produit fini créée
# automatiquement à l'entrée Z1. Défaut SIFA : étiquette.
# STOCK_UNITE_VENTE_DEFAUT=étiquette

# ─── ERP RVGI (base HFSQL sifa_cs) ───────────────────────────────────
# Lu par scripts/export_rvgi_csv.ps1, jamais par l'application.
# Compte de LECTURE SEULE dédié — jamais un compte applicatif.
# Le serveur n'est joignable que depuis le réseau SIFA.
HFSQL_CONN=provider=PCSoft.HFSQL;initial catalog=sifa_cs;data source=192.168.100.199:4949;extended properties="Language=ISO-8859-1"
HFSQL_UID=compte_lecture
HFSQL_PWD=

# Miroir SQLite de l'ERP, construit par scripts/import_rvgi_csv.py.
# Défaut : data/erp_mirror.db. Absent = l'app ERP annonce « miroir absent ».
# ERP_MIRROR_DB=data/erp_mirror.db

# ─── Synchro RVGI → MySifa (scripts/sync_rvgi.ps1) ───────────────────
# Lu UNIQUEMENT par la machine du réseau SIFA qui pousse le miroir.
# Les instances qui reçoivent n'ont besoin de rien de tout ça.
# Une URL par instance, séparées par des virgules.
MYSIFA_SYNC_URLS=https://v1.mysifa.com,https://www.mysifa.com
# Clé créée dans Paramètres › Clés API, portée « Synchro ERP RVGI ».
MYSIFA_API_KEY=

# Remontee des erreurs de production (optionnel).
# Vide = desactive : aucune dependance requise, aucun appel reseau.
# Pour l'activer : creer un projet sur sentry.io, coller le DSN ici, et
#   pip install 'sentry-sdk[fastapi]'
# Ce qui ne part jamais, meme actif : cookies, en-tetes d'autorisation,
# corps de requete. Voir app/core/monitoring.py.
SENTRY_DSN=
